{
  "schemaVersion": 1,
  "id": "cinema-opt",
  "version": "${version}",
  "name": "Cinema Optimized Experience",
  "description": "A fully client-side enhancement modpack-style overhaul: optimization, cinematic camera, animated 3D items and hands, and a pile of QoL and utility features.",
  "authors": [
    "EnderDevelopment"
  ],
  "contact": {
    "homepage": "https://example.com/",
    "sources": "https://github.com/"
  },
  "license": "MIT",
  "icon": "assets/cinema-opt/icon.svg",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.enderev.cinemaopt.CinemaOpt"
    ],
    "client": [
      "com.enderev.cinemaopt.client.CinemaOptClient"
    ]
  },
  "mixins": [
    "cinema-opt.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
